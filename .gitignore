# secrets
.env
.env.*
!.env.example

# local session state (keep out of the public repo)
HANDOFF.md
.handoff/
.litclaude/
.litmuse/
*.textClipping
.DS_Store

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# runtime output
data/cache/
logs/

# demo video: only the final cut is tracked (linked from the README)
submission/video/*.mp4
!submission/video/OAH2026-SiteWhy-ExplainWhy-Demo.mp4

# fetched source documents (re-fetchable cache; the sample-mode replay set
# below is re-included file by file, so plain `git add` picks up exactly it)
data/sources/*
data/llm_cache/*
data/geo/cache/*

# per-run traces (selected runs are copied to samples/)
runs/

# sample-mode replay set (P1-3): exactly the caches the 4 showcase runs read.
# Everything else under these dirs stays ignored (local and live runs).
