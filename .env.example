# Copy values into ~/.hackathon-keys.env (outside the repo) or export them.
# Never commit real values.

# Meterless Nightshift (primary AI provider). The token is read from Nightshift's
# runtime-token file by default; set these only to override.
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_TOKEN_FILE=
METERLESS_RUNTIME_TOKEN=

# Zetaris (data layer), local Docker install
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=

# Run without Nightshift/Zetaris using bundled sample responses
SAMPLE_MODE=false
